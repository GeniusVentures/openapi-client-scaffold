{#
  form_dialog.css.jinja2 — M3 Form Dialog CSS generator.

  Template variables: none used (pure CSS output — no Jinja2 expressions).

  Generates CSS for <dialog> styling, form field layout, validation states,
  loading spinner, and responsive form factor adaptations.  All colors use
  var(--md-sys-color-*) — zero hardcoded hex values.
#}
/* Auto-generated from form_dialog.css.jinja2 — do not edit by hand. */

/* ---------------------------------------------------------------------------
   Form Dialog — Base (Desktop >=1024px)
   --------------------------------------------------------------------------- */

/* --- Dialog and backdrop ------------------------------------------------- */

.m3-form-dialog {
  max-width: 520px;
  width: 100%;
  padding: 0;
  border: none;
  border-radius: var(--md-sys-shape-large);
  background-color: var(--md-sys-color-surface);
  box-shadow: var(--md-sys-elevation-level3);
  color: var(--md-sys-color-on-surface);
  font-family: var(--md-sys-typography-body-font);
  font-size: var(--md-sys-typography-body-size);
  line-height: var(--md-sys-typography-body-line-height);
}

.m3-form-dialog::backdrop {
  background-color: rgba(0, 0, 0, 0.5);
}

.m3-form-dialog__content {
  padding: 24px;
}

/* --- Header -------------------------------------------------------------- */

.m3-form-dialog__header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24px;
}

.m3-form-dialog__title {
  margin: 0;
  font-family: var(--md-sys-typography-title-font);
  font-size: var(--md-sys-typography-title-size);
  font-weight: var(--md-sys-typography-title-weight);
  line-height: var(--md-sys-typography-title-line-height);
  letter-spacing: var(--md-sys-typography-title-letter-spacing);
  color: var(--md-sys-color-on-surface);
}

.m3-form-dialog__close {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  padding: 0;
  border: none;
  border-radius: var(--md-sys-shape-small);
  background: none;
  color: var(--md-sys-color-on-surface-variant);
  font-size: 20px;
  cursor: pointer;
}

.m3-form-dialog__close:hover {
  background-color: var(--md-sys-color-surface-variant);
}

/* --- Form fields --------------------------------------------------------- */

.m3-form-dialog__form {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.m3-form-dialog__field {
  display: flex;
  flex-direction: column;
  gap: 6px;
}

.m3-form-dialog__label {
  font-family: var(--md-sys-typography-label-font);
  font-size: var(--md-sys-typography-label-size);
  font-weight: var(--md-sys-typography-label-weight);
  letter-spacing: var(--md-sys-typography-label-letter-spacing);
  line-height: var(--md-sys-typography-label-line-height);
  color: var(--md-sys-color-on-surface-variant);
}

.m3-form-dialog__required {
  color: var(--md-sys-color-error);
  margin-left: 2px;
}

.m3-form-dialog__input,
.m3-form-dialog__select {
  padding: 10px 12px;
  border: 1px solid var(--md-sys-color-outline);
  border-radius: var(--md-sys-shape-small);
  background-color: var(--md-sys-color-surface);
  color: var(--md-sys-color-on-surface);
  font-family: var(--md-sys-typography-body-font);
  font-size: var(--md-sys-typography-body-size);
  line-height: var(--md-sys-typography-body-line-height);
  outline: none;
  transition: border-color 0.2s ease;
}

.m3-form-dialog__input:focus,
.m3-form-dialog__select:focus {
  border-color: var(--md-sys-color-primary);
  border-width: 2px;
}

.m3-form-dialog__input::placeholder {
  color: var(--md-sys-color-on-surface-variant);
  opacity: 0.6;
}

/* --- Validation states --------------------------------------------------- */

.m3-form-dialog__input[data-valid="false"][data-error]:not([data-error=""]) {
  border-color: var(--md-sys-color-error);
}

.m3-form-dialog__select[data-valid="false"][data-error]:not([data-error=""]) {
  border-color: var(--md-sys-color-error);
}

.m3-form-dialog__error {
  display: none;
  font-family: var(--md-sys-typography-label-font);
  font-size: var(--md-sys-typography-label-size);
  line-height: var(--md-sys-typography-label-line-height);
  color: var(--md-sys-color-error);
  min-height: var(--md-sys-typography-label-line-height);
}

.m3-form-dialog__input[data-error]:not([data-error=""]) + .m3-form-dialog__error,
.m3-form-dialog__select[data-error]:not([data-error=""]) + .m3-form-dialog__error {
  display: block;
}

/* --- Global error display ------------------------------------------------ */

.m3-form-dialog__global-error {
  padding: 12px 16px;
  border-radius: var(--md-sys-shape-small);
  background-color: var(--md-sys-color-error);
  color: var(--md-sys-color-on-error);
  font-family: var(--md-sys-typography-label-font);
  font-size: var(--md-sys-typography-label-size);
  line-height: var(--md-sys-typography-label-line-height);
}

.m3-form-dialog__global-error[hidden] {
  display: none;
}

/* --- Action buttons ------------------------------------------------------ */

.m3-form-dialog__actions {
  display: flex;
  justify-content: flex-end;
  gap: 12px;
  margin-top: 8px;
}

.m3-form-dialog__btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 10px 24px;
  border: none;
  border-radius: var(--md-sys-shape-medium);
  font-family: var(--md-sys-typography-label-font);
  font-size: var(--md-sys-typography-label-size);
  font-weight: var(--md-sys-typography-label-weight);
  letter-spacing: var(--md-sys-typography-label-letter-spacing);
  line-height: var(--md-sys-typography-label-line-height);
  cursor: pointer;
  transition: background-color 0.2s ease;
}

.m3-form-dialog__btn--cancel {
  background: none;
  color: var(--md-sys-color-on-surface-variant);
}

.m3-form-dialog__btn--cancel:hover {
  background-color: var(--md-sys-color-surface-variant);
}

.m3-form-dialog__btn--submit {
  background-color: var(--md-sys-color-primary);
  color: var(--md-sys-color-on-primary);
}

.m3-form-dialog__btn--submit:hover {
  opacity: 0.92;
}

.m3-form-dialog__btn--submit:disabled {
  opacity: 0.38;
  cursor: default;
}

/* --- Loading spinner ----------------------------------------------------- */

.m3-form-dialog__submit-label {
  display: inline;
}

.m3-form-dialog__spinner {
  display: inline-block;
  width: 18px;
  height: 18px;
  border: 2px solid var(--md-sys-color-on-primary);
  border-top-color: transparent;
  border-radius: 50%;
  animation: m3-spin 0.6s linear infinite;
}

.m3-form-dialog__spinner[hidden] {
  display: none;
}

@keyframes m3-spin {
  0%   { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}


/* ---------------------------------------------------------------------------
   Mobile (<600px) — Full-width dialog, stacked actions
   --------------------------------------------------------------------------- */

@media (max-width: 599px) {

  .m3-form-dialog {
    max-width: calc(100vw - 32px);
    margin: 16px;
    border-radius: var(--md-sys-shape-large);
  }

  .m3-form-dialog__content {
    padding: 16px;
  }

  .m3-form-dialog__header {
    margin-bottom: 16px;
  }

  .m3-form-dialog__form {
    gap: 16px;
  }

  .m3-form-dialog__actions {
    flex-direction: column-reverse;
    gap: 8px;
  }

  .m3-form-dialog__btn {
    width: 100%;
    padding: 12px 24px;
  }

  .m3-form-dialog__btn--submit {
    width: 100%;
  }

}
