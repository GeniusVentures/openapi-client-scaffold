      await widget.onSearch?.call(value);
    } catch (e) {
      cubit.failSearch(e.toString());
    }
  }

  void _clearSearch({{ widget_class_name }}Cubit cubit) {
    _controller.clear();
    cubit.clearQuery();
    setState(() => _showResults = false);
  }

  @override
  void dispose() {
    _controller.dispose();
    _focusNode.removeListener(_onFocusChange);
    _focusNode.dispose();
