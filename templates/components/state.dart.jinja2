{% else %}
    // =====================================================================
    // Unknown state type — template debugging fallback
    // =====================================================================
    return Center(
      child: Text(
        'Unknown state type: {{ state_type }}',
        style: textTheme.bodyMedium?.copyWith(
          color: colorScheme.error,
        ),
      ),
    );

{% endif %}
  }
}
