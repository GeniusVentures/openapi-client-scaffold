name: {{ api_module_id }}
description: "{{ display_name }} module for Genius AI Boss"
publish_to: 'none'
version: 1.0.0+0

environment:
  sdk: ^3.5.0

resolution: workspace

dependencies:
  flutter:
    sdk: flutter
  flutter_riverpod: ^2.6.1
  go_router: ^14.8.1
  auth:
    path: ../../packages/auth
  api_client:
    path: ../../packages/api_client
  {{ api_package }}:
    path: ../../packages/api_client/lib/generated/{{ domain }}
  ui_core:
    path: ../../packages/ui_core
  navigation:
    path: ../../packages/navigation
  models:
    path: ../../packages/models

dev_dependencies:
  flutter_test:
    sdk: flutter
  flutter_lints: ^5.0.0
